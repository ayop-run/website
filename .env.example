# Supabase → Project Settings → API
# Project URL → NEXT_PUBLIC_SUPABASE_URL
# service_role key (secret) → SUPABASE_SERVICE_ROLE_KEY — never expose to the client
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin password (server only). Used for Photos unlock and PATCH / edit.
ADMIN_PASSWORD=

# Optional production-style check (use instead of ADMIN_PASSWORD):
# ADMIN_PASSWORD_BCRYPT=